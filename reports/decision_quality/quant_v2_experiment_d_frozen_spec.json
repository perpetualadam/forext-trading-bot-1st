{
  "frozen_before_market_outcomes": true,
  "period_primary": "2025-09-01 through 2026-08-31 UTC DEVELOPMENT/DISCOVERY",
  "older_history_role": "optional extra DEVELOPMENT only if the same official source provides it cleanly; never a final holdout",
  "authorized_currencies": ["USD", "GBP", "CAD"],
  "authorized_categories": ["INFLATION", "EMPLOYMENT", "CENTRAL_BANK_DECISION"],
  "disallowed_fields": [
    "consensus",
    "forecast",
    "actual",
    "revised_actual",
    "surprise",
    "news",
    "statement_text",
    "minutes_text"
  ],
  "official_clock_conventions": {
    "BLS": {"local_clock": "08:30", "tz": "America/New_York", "note": "Eastern Time on BLS national release calendar"},
    "FOMC": {"local_clock": "14:00", "tz": "America/New_York", "note": "Typical statement 'For release at 2:00 p.m. ET'. Unscheduled intermeetings marked UNCERTAIN if clock not on the page."},
    "ONS": {"local_clock": "07:00", "tz": "Europe/London", "note": "UK official statistics standard publication time"},
    "BOE_MPC": {"local_clock": "12:00", "tz": "Europe/London", "note": "Bank of England: decision and minutes at 12 noon UK"},
    "STATCAN": {"local_clock": "08:30", "tz": "America/New_York", "note": "Statistics Canada The Daily / WDS releaseTime 08:30 ET"},
    "BOC": {"local_clock": "09:45", "tz": "America/Toronto", "note": "Official BoC 2025/2026 schedule pages: all interest rate announcements at 09:45 ET."}
  },
  "event_name_map": {
    "Consumer Price Index": "INFLATION",
    "CPI": "INFLATION",
