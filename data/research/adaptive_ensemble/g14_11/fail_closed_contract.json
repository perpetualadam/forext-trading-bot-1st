{
  "stage": "G.14.11",
  "implemented": false,
  "fallback_to_sender_path": "forbidden",
  "synthetic_success_authorises_real_acquisition": false,
  "automatic_deletion_of_historical_evidence": false,
  "automatic_cleanup_of_production": false,
  "conditions": [
    {"condition": "unverified_receiving_principal", "detection": "receiver SID missing or unequal", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": "only after a new approval creates the principal", "manual_approval": true, "audit": "reason and observed SID"},
    {"condition": "unverified_directory_identity", "detection": "file id missing or changed", "state": "FAILED_CLOSED", "bytes_may_remain": "only unpublished files the receiver itself created", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "both file ids"},
    {"condition": "unverified_directory_ownership", "detection": "owner SID not the receiver", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "owner SID"},
    {"condition": "unverified_acl", "detection": "substitution test not passed or ACL unreadable", "state": "RECEIVER_UNINITIALISED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "test absent"},
    {"condition": "reparse_point", "detection": "FILE_ATTRIBUTE_REPARSE_POINT", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "attribute bit"},
    {"condition": "initial_path_substitution", "detection": "medium-integrity swap succeeds, or the test was never run", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "swap result"},
    {"condition": "untrusted_handle", "detection": "handle offered by the sender", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": false, "audit": "handle rejected"},
    {"condition": "sender_authentication_failure", "detection": "client SID mismatch", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": "a new session may start; the failed one may not", "manual_approval": false, "audit": "rejected SID"},
    {"condition": "receiver_authentication_failure", "detection": "server SID mismatch", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": false, "audit": "rejected SID"},
    {"condition": "unapproved_artifact", "detection": "name, type, or set mismatch", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "name and reason"},
    {"condition": "unapproved_source", "detection": "source not on an approval", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "source string"},
    {"condition": "unapproved_redirect", "detection": "provenance URL leaves the approved host", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "URL"},
    {"condition": "hash_mismatch", "detection": "receiver hash differs", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": false, "audit": "both hashes"},
    {"condition": "size_mismatch", "detection": "read-back length differs", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": false, "audit": "both lengths"},
    {"condition": "wheel_integrity_failure", "detection": "inspect_wheel_bytes fails", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": false, "audit": "verifier reason"},
    {"condition": "metadata_mismatch", "detection": "WHEEL or METADATA check fails", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": false, "audit": "verifier reason"},
    {"condition": "dependency_graph_mismatch", "detection": "assert_dependency_graph fails or profile incomplete", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "graph reason"},
    {"condition": "target_compatibility_mismatch", "detection": "tags unknown or mismatched", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "missing field names"},
    {"condition": "lockfile_mismatch", "detection": "lock hash or marker mismatch, or lock is synthetic", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "lock marker"},
