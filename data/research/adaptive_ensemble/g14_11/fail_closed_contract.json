    {"condition": "crash", "detection": "no valid commit record after restart", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": "new transfer only", "manual_approval": false, "audit": "missing commit"},
    {"condition": "partial_publication", "detection": "commit record incomplete", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "truncated record"},
    {"condition": "post_verification_mutation", "detection": "re-read hash or file id changed", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "both hashes"},
    {"condition": "unauthorized_consumer", "detection": "consumer SID not allowlisted", "state": "FAILED_CLOSED", "bytes_may_remain": "already stored bytes stay unpublished to that consumer", "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "rejected SID"},
    {"condition": "production_mount_exposure", "detection": "destination is a production, operational, or shadow path", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "rejected path class, not file contents"},
    {"condition": "credential_exposure", "detection": "backup filename or .env name", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": false, "audit": "filename only"},
    {"condition": "network_policy_failure", "detection": "any socket, or a provenance host outside a future approval", "state": "FAILED_CLOSED", "bytes_may_remain": "unpublished", "cleanup_allowed": "not automatic", "recoverable": false, "manual_approval": true, "audit": "host or the fact of a socket"},
    {"condition": "unknown_security_state", "detection": "any check not implemented or not run", "state": "FAILED_CLOSED", "bytes_may_remain": false, "cleanup_allowed": false, "recoverable": false, "manual_approval": true, "audit": "which check was unknown"}
  ]
}
