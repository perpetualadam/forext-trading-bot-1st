# Copy to .env and fill in. docker compose reads .env automatically.

# OANDA (required for candle data)
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=

# practice | live — switches OANDA API environment for market data only
TRADING_MODE=practice

# PostgreSQL (defaults match docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=trading

# Host port for the dashboard (compose default is 8001; set 8000 here if you prefer)
BOT_PORT=8001

# Optional alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# LLM voters (ensemble). Any API key / URL you set registers that voter.
# Multiple providers = multiple API calls per symbol per cycle (cost + latency).
# Turn off the random stub when using real models only:
# AI_DISABLE_STUB=true
# =============================================================================

AI_DISABLE_STUB=false
STUB_ALLOW_THRESHOLD=0.6
STUB_CONFIDENCE_MIN=0.4
STUB_CONFIDENCE_MAX=0.85

# -----------------------------------------------------------------------------
# OpenAI (or any OpenAI-compatible URL: Ollama, Azure-style base, etc.)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_JSON_MODE=true
# OPENAI_TIMEOUT=60
# OPENAI_TEMPERATURE=0.2
# Ollama on host (Docker Desktop):
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# OPENAI_JSON_MODE=false

# -----------------------------------------------------------------------------
# Anthropic (native Messages API — not OpenAI-compatible)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=512
# ANTHROPIC_TIMEOUT=60

# -----------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Mistral (OpenAI-compatible)
# -----------------------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# xAI Grok (OpenAI-compatible). Use XAI_API_KEY or GROK_API_KEY.
# -----------------------------------------------------------------------------
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-2-latest

# -----------------------------------------------------------------------------
# Groq (OpenAI-compatible). If you meant “Grok”, use the xAI block above.
# -----------------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Venice AI (OpenAI-compatible — confirm model IDs and base URL in their docs)
# -----------------------------------------------------------------------------
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/v1
# VENICE_MODEL=venice-uncensored
# VENICE_JSON_MODE=false

# -----------------------------------------------------------------------------
# Qrok / custom OpenAI-compatible endpoint (set base URL from provider docs)
# -----------------------------------------------------------------------------
# QROK_API_KEY=
# QROK_BASE_URL=
# QROK_MODEL=default
# QROK_JSON_MODE=false

# =============================================================================
# Hybrid scalp / swing routing (per symbol). Symbol must match Config.SYMBOLS.
# When HYBRID_<SYMBOL>=true, ATR vs median ATR picks scalp vs swing family;
# when false, behaviour matches legacy meta-learner over all strategies.
# =============================================================================
 HYBRID_EUR_USD=true
 HYBRID_GBP_USD=true
 HYBRID_USD_JPY=false
 SCALP_LOOKBACK=50
 SWING_LOOKBACK=100
 DEFAULT_INDICATOR_LOOKBACK=50
 HYBRID_ROUTE_LOOKBACK=60
 HYBRID_ATR_SCALP_THRESHOLD=1.0
 HYBRID_OHLCV_COUNT=200

# =============================================================================
# Live trading windows (per symbol, UTC)
# With PAPER_TRADING=false, real fills use the "live" path only inside these hours;
# outside the window, the bot still runs hybrid/AI/RL using simulate_execution().
# With PAPER_TRADING=true, all fills are simulated regardless of these times.
# =============================================================================
# LIVE_EUR_USD_START=13:00
# LIVE_EUR_USD_END=17:00
# LIVE_GBP_USD_START=13:00
# LIVE_GBP_USD_END=17:00
# LIVE_USD_JPY_START=13:00
# LIVE_USD_JPY_END=17:00

# =============================================================================
# Optional short intraday "scalp" sub-window (UTC), nested inside LIVE_* above.
# Both START and END must be set for a symbol to narrow that symbol's live fills;
# if either is unset, is_live_trading(..., use_scalp_window=True) uses the full LIVE window only.
# In bot_loop.py, uncomment is_live_trading(symbol, use_scalp_window=True) to enable.
# =============================================================================
# SCALP_EUR_USD_START=13:00
# SCALP_EUR_USD_END=15:00
# SCALP_GBP_USD_START=13:00
# SCALP_GBP_USD_END=15:00
# SCALP_USD_JPY_START=13:00
# SCALP_USD_JPY_END=15:00


# Risk per open position as fraction of equity (stop distance vs SL); used by position_sizing()
# POSITION_RISK_PCT=0.01

# Spread / slippage model (apply_execution_costs in trading.py)
# SPREAD_MULTIPLIER=1.0
# SLIPPAGE_MULTIPLIER=1.0

# Execution delay (ms) and simple order-book impact (price units per unit size; broker-agnostic)
# LATENCY_MS=50
# MARKET_IMPACT_FACTOR=0.0000005

# Per-symbol simulation layers (latency, market impact, spread/slippage):
# - Outside LIVE_* window OR PAPER_TRADING=true → full simulation stack runs (unless false below).
# - SIMULATION_<SYMBOL>=false → disables simulation layers even for paper/off-window (raw mid only).
# - SIMULATION_<SYMBOL>=true → explicit default (same as omitting the variable).
 SIMULATION_EUR_USD=true
 SIMULATION_GBP_USD=true
 SIMULATION_USD_JPY=true

# =============================================================================
# Optional micro-strategy labels / lot overrides (see MICRO_STRATEGY / LOT_SIZE HOOK in bot_loop.py)
# =============================================================================
 MICRO_STRATEGY_EUR_USD=scalp_1h
 LOT_SIZE_OVERRIDE_USD_JPY=0.10

# =============================================================================
# Historical backtest (CLI: python -m forex_bot.backtest --help)
# Fetches OANDA candles per regime; requires valid OANDA_ACCESS_TOKEN + TRADING_MODE.
BACKTEST_SEED=42
BACKTEST_STEP_BARS=1
# =============================================================================
