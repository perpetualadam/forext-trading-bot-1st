# Copy to .env and fill in. Docker Compose reads .env automatically.
# Local `python main.py` / backtests: python-dotenv loads this (forex_bot.config).

# =============================================================================
# OANDA (required for live bot + OANDA-based backtests; omit token if BACKTEST_CSV only)
# =============================================================================
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
# OANDA_API_KEY=   # optional alias for OANDA_ACCESS_TOKEN

# practice | live — OANDA REST host + token type (unchanged; not the same as EXECUTION_MODE).
TRADING_MODE=practice

# Legacy: gates OANDA orders when EXECUTION_MODE is **unset** (see forex_bot/oanda_exec.use_oanda_live).
USE_OANDA_LIVE=false

# Legacy: used only when EXECUTION_MODE is unset — maps to paper / paper_broker / live_broker.
PAPER_TRADING=true

# =============================================================================
# Execution profile (forex_bot/execution.py) — set this to remove ambiguity:
#   paper         — fully simulated; never sends OANDA orders
#   paper_broker  — practice account orders enabled (TRADING_MODE should be practice)
#   live_broker   — live account orders enabled (TRADING_MODE should be live)
# If unset, PAPER_TRADING + TRADING_MODE derive the same three modes.
# =============================================================================
# EXECUTION_MODE=paper
# KILL_SWITCH=false
# STRICT_EXECUTION=1
# RECONCILE_INTERVAL_SEC=60
# Periodic BOT STATUS (same metrics as BOT STARTED); seconds between snapshots. Default 21600 = 6h. 0 = off.
# HEALTH_SNAPSHOT_INTERVAL_SEC=21600
# DAILY REPORT alert in bot loop: minimum seconds between reports (was once per calendar day). Default 86400 = 24h; 21600 = every 6h. 0 = off.
# DAILY_REPORT_INTERVAL_SEC=86400
# RECONCILE_MAX_AGE_SEC=300
# RECONCILE_ON_RESUME=false
# Broker-truth: log_only | auto_fix. auto_fix aligns local registry to broker (close ghost locals, optional import).
# With EXECUTION_MODE=paper, also set RECONCILE_AUTO_FIX_IN_PAPER=true if you need ghost locals removed when broker is flat.
# RECONCILE_ACTION=log_only
# RECONCILE_AUTO_FIX_IN_PAPER=false
# RECONCILE_IMPORT_BROKER_POSITIONS=false
# RECONCILE_ADJUST_UNITS=false
# Cap auto-fix actions per reconcile run (0 = unlimited)
# RECONCILE_MAX_FIXES_PER_CYCLE=50
# Persist exec_orders (idempotency); set false for memory-only. When true, PostgreSQL must be reachable
# or live order reservation fails (avoids broker submits without durable dedup).
# PERSIST_EXEC_ORDERS=1
# BLOCK_NEW_ENTRIES_ON_RECONCILE_MISMATCH=false
# When unset, REQUIRE_CLEAN_RECONCILE_FOR_BROKER defaults ON for paper_broker/live_broker.
# REQUIRE_CLEAN_RECONCILE_FOR_BROKER=false
# SKIP_RECONCILE_GATE_FOR_BROKER=false
# Persist last reconcile outcome to PostgreSQL so restarts keep last_run / success (staleness semantics).
# PERSIST_RECONCILE_STATE=1
# Bounded ring of operational state transitions on GET /system + bot loop (append on change only).
# OPERATIONAL_EVENT_MAX=100
# Mirror transitions to PostgreSQL operational_event_log (append-only).
# PERSIST_OPERATIONAL_EVENTS=false
# On startup, refill deque from last OPERATIONAL_EVENT_MAX rows (after lifespan is running).
# LOAD_OPERATIONAL_EVENTS_FROM_DB=false

# OANDA REST tuning (forex_bot/oanda_client.py). Backtest sets chunk delay 0 unless you override.
# OANDA_CHUNK_DELAY_SEC=0.1
# OANDA_MAX_RETRIES=6
# OANDA_MAX_CANDLES_PER_REQUEST=5000

# =============================================================================
# PostgreSQL — Compose maps POSTGRES_PASSWORD into the bot container as POSTGRES_PASS.
# Local Python on host: set POSTGRES_PASS (and HOST/PORT) to match your DB.
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PASS=password
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

BOT_PORT=8001

# Optional alerts (TELEGRAM_BOT_TOKEN is an alias for TELEGRAM_TOKEN)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# =============================================================================
# LLM ensemble — experiment.py / ai_ensemble.py
# ENSEMBLE_MODE: quant | api | hybrid (default hybrid). quant = LocalLLM stub only; api = API voters only.
# NN_PRED_MODE: noise | seq | price | zero — see forex_bot/nn_pred.py (empty = backtest→seq, live→noise)
# =============================================================================
AI_DISABLE_STUB=false
# ENSEMBLE_MODE=hybrid
# NN_PRED_MODE=seq

# Quant stub tuning (ai_ensemble LocalLLM). Not used: STUB_ALLOW_THRESHOLD / STUB_CONFIDENCE_MIN / MAX (removed).
# STUB_SMA_EPSILON=1e-6
# STUB_MOMENTUM_THRESHOLD=0.0001
# STUB_CONFIDENCE_SCALE=1000

# -----------------------------------------------------------------------------
# OpenAI (or any OpenAI-compatible URL: Ollama, Azure-style base, etc.)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_JSON_MODE=true
# OPENAI_TIMEOUT=60
# OPENAI_TEMPERATURE=0.2
# Ollama on host (Docker Desktop):
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# OPENAI_JSON_MODE=false
# Ollama in Compose (profile ollama): OPENAI_BASE_URL=http://ollama:11434/v1
# OLLAMA_HOST_PORT=11434
# OLLAMA_KEEP_ALIVE=24h

# -----------------------------------------------------------------------------
# Anthropic (native Messages API — not OpenAI-compatible)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=512
# ANTHROPIC_TIMEOUT=60
# ANTHROPIC_VERSION=2023-06-01

# -----------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Mistral (OpenAI-compatible)
# -----------------------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# xAI Grok (OpenAI-compatible). Use XAI_API_KEY or GROK_API_KEY.
# -----------------------------------------------------------------------------
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-2-latest
# XAI_MODEL=

# -----------------------------------------------------------------------------
# Groq (OpenAI-compatible). If you meant “Grok”, use the xAI block above.
# -----------------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Venice AI (OpenAI-compatible — confirm model IDs and base URL in their docs)
# -----------------------------------------------------------------------------
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/v1
# VENICE_MODEL=venice-uncensored
# VENICE_JSON_MODE=false

# -----------------------------------------------------------------------------
# Qrok / custom OpenAI-compatible endpoint (set base URL from provider docs)
# -----------------------------------------------------------------------------
# QROK_API_KEY=
# QROK_BASE_URL=
# QROK_MODEL=default
# QROK_JSON_MODE=false

# =============================================================================
# Hybrid scalp / swing routing (per symbol). Symbol must match Config.SYMBOLS.
# =============================================================================
HYBRID_EUR_USD=true
HYBRID_GBP_USD=true
HYBRID_USD_JPY=false
SCALP_LOOKBACK=50
SWING_LOOKBACK=100
DEFAULT_INDICATOR_LOOKBACK=50
HYBRID_ROUTE_LOOKBACK=60
HYBRID_ATR_SCALP_THRESHOLD=1.0
HYBRID_OHLCV_COUNT=200

# =============================================================================
# Live trading windows (per symbol, UTC)
# =============================================================================
# LIVE_EUR_USD_START=13:00
# LIVE_EUR_USD_END=17:00
# LIVE_GBP_USD_START=13:00
# LIVE_GBP_USD_END=17:00
# LIVE_USD_JPY_START=13:00
# LIVE_USD_JPY_END=17:00

# =============================================================================
# Optional scalp sub-window (UTC); enable is_live_trading(..., use_scalp_window=True) in bot_loop if used
# =============================================================================
# SCALP_EUR_USD_START=13:00
# SCALP_EUR_USD_END=15:00
# SCALP_GBP_USD_START=13:00
# SCALP_GBP_USD_END=15:00
# SCALP_USD_JPY_START=13:00
# SCALP_USD_JPY_END=15:00

# Risk / portfolio (trading.py)
# Minimum seconds position must be open before SL/TP exits are allowed (0 = off, exit on first touch).
MIN_POSITION_HOLD_SEC=0
POSITION_RISK_PCT=0.01
POSITION_RISK_PCT_MAX=0.01
# MAX_PORTFOLIO_RISK_PCT=0.05
# MAX_POSITION_UNITS=0
# Approximate gross USD notional cap across open positions (0 = off). See portfolio_exposure.py.
# MAX_GROSS_USD_NOTIONAL=0
# MIN_STOP_DISTANCE_PRICE=0
# USE_ATR_STOPS=false
# SL_ATR_MULT=2.0

# Spread / slippage / latency (trading.py)
# SPREAD_MULTIPLIER=1.0
# SLIPPAGE_MULTIPLIER=1.0
# SLIPPAGE_ATR_FRACTION=0.3
# LATENCY_MS=50
# MARKET_IMPACT_FACTOR=0.0000005
# Rolling sample size for execution_metrics slippage/latency (forex_bot/execution_metrics.py)
# EXECUTION_METRICS_MAX_SAMPLES=500

# Per-symbol simulation layers (session_rules.py)
SIMULATION_EUR_USD=true
SIMULATION_GBP_USD=true
SIMULATION_USD_JPY=true

# Optional micro-strategy / lot hooks (uncomment hook in bot_loop.py to use)
MICRO_STRATEGY_EUR_USD=scalp_1h
LOT_SIZE_OVERRIDE_USD_JPY=0.10

# =============================================================================
# Historical backtest (python -m forex_bot.backtest --help)
# FOREX_BACKTEST=1 is set by the CLI; BACKTEST_CSV for default CSV path without --csv
# =============================================================================
# BACKTEST_CSV=./data/eurusd_m5_2024_sample.csv
BACKTEST_SEED=42
BACKTEST_STEP_BARS=1
# BACKTEST_FAST_WINDOW=true
# BACKTEST_INDICATOR_WINDOW=1500
