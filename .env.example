# Copy to .env and fill in. docker compose reads .env automatically.

# OANDA (required for candle data)
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=

# practice | live — switches OANDA API environment for market data only
TRADING_MODE=practice

# Final Boss++ paper path: spread/slippage sim + RL reward from simulate_execution PnL
# false = legacy random PnL per trade until real OANDA execution is wired
PAPER_TRADING=true

# PostgreSQL (defaults match docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=trading

# Host port for the dashboard (compose default is 8001; set 8000 here if you prefer)
BOT_PORT=8001

# =============================================================================
# LLM voters (ensemble). Any API key / URL you set registers that voter.
# Multiple providers = multiple API calls per symbol per cycle (cost + latency).
# Turn off the random stub when using real models only:
# AI_DISABLE_STUB=true
#
# Tune the random stub (when AI_DISABLE_STUB=false). Allow if random.uniform(0,1) > threshold.
#   STUB_ALLOW_THRESHOLD=0.3  → ~70% allow (default). Higher → fewer trades (e.g. 0.7 → ~30%).
#   STUB_CONFIDENCE_MIN=0.5   → lower bound of stub confidence (0–1)
#   STUB_CONFIDENCE_MAX=1.0   → upper bound
# STUB_ALLOW_THRESHOLD=0.3
# STUB_CONFIDENCE_MIN=0.5
# STUB_CONFIDENCE_MAX=1.0
# =============================================================================
AI_DISABLE_STUB=false

# -----------------------------------------------------------------------------
# OpenAI (or any OpenAI-compatible URL: Ollama, Azure-style base, etc.)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_JSON_MODE=true
# OPENAI_TIMEOUT=60
# OPENAI_TEMPERATURE=0.2
# Ollama on Windows/Mac host while the bot runs in Docker:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# OPENAI_JSON_MODE=false
#
# Ollama inside the same Compose stack (optional service, profile "ollama"):
#   docker compose --profile ollama up -d
# Then set (service hostname is "ollama" on the compose network):
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# OPENAI_JSON_MODE=false
# AI_DISABLE_STUB=true
# Pull a model once after first start:
#   docker compose exec ollama ollama pull llama3.2
# Host port for Ollama UI / CLI from your machine (optional):
# OLLAMA_HOST_PORT=11434

# -----------------------------------------------------------------------------
# Anthropic (native Messages API — not OpenAI-compatible)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=512
# ANTHROPIC_TIMEOUT=60

# -----------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Mistral (OpenAI-compatible)
# -----------------------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# xAI Grok (OpenAI-compatible). Use XAI_API_KEY or GROK_API_KEY.
# -----------------------------------------------------------------------------
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-2-latest

# -----------------------------------------------------------------------------
# Groq (OpenAI-compatible). If you meant “Grok”, use the xAI block above.
# -----------------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Venice AI (OpenAI-compatible — confirm model IDs and base URL in their docs)
# -----------------------------------------------------------------------------
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/v1
# VENICE_MODEL=venice-uncensored
# VENICE_JSON_MODE=false

# -----------------------------------------------------------------------------
# Qrok / custom OpenAI-compatible endpoint (set base URL from provider docs)
# -----------------------------------------------------------------------------
# QROK_API_KEY=
# QROK_BASE_URL=
# QROK_MODEL=default
# QROK_JSON_MODE=false

# Optional alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
